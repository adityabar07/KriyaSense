# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# --- FastAPI app ---
API_TITLE=KRIYA-SENSE Backend
API_VERSION=0.1.0-placeholder

# --- Uvicorn server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --- CORS ---
# Comma-separated list of allowed origins, or * for any (dev default).
CORS_ORIGINS=*

# --- Frontend static serving ---
SERVE_FRONTEND=true
